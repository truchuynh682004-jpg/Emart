
# SQL Server - chạy trực tiếp trên máy Windows
DB_SERVER=localhost
DB_DATABASE=StorePOS
DB_USER=sa
DB_PASSWORD=your_password_here
DB_PORT=1433

# Docker SQL Server
DOCKER_DB_PASSWORD=your_docker_password_here

# Restore configuration
ENABLE_PRODUCTION_RESTORE=false

# Đường dẫn thư mục backup trên máy tính
BACKUP_HOST_PATH=E:/StorePOS_Backup